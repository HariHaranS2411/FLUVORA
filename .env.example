# Open-Meteo's free endpoints need no key. A customer key uses reserved
# endpoints; the Archive API requires the Professional plan or higher.
# Set OPEN_METEO_API_KEY in the backend environment, never in frontend code.
OPEN_METEO_API_KEY=

# Other variables for services that genuinely require registration.
# GDACS and geoBoundaries are public; see DATA_SOURCE_MATRIX.md.

# NASA POWER (optional backup rainfall source) — free key at:
#   https://power.larc.nasa.gov/  (Registration -> API key)
NASA_POWER_API_KEY=

# UN OCHA ReliefWeb events (optional supplementary source) — request an appname:
#   https://apidoc.reliefweb.int/
RELIEFWEB_APPNAME=

# Government of India Open Data (data.gov.in) — real dataset ingestion:
#   1. Register at https://data.gov.in/user/register (free)
#   2. Set your key below
#   3. List comma-separated resource IDs from the dataset pages you want ingested
#   4. Trigger POST /api/data-gov-in/ingest (real rows only; honest errors otherwise)
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCES=

# Database (SQLite by default; use PostGIS in production):
# DATABASE_URL=postgresql+psycopg://flashflood:flashflood@localhost:5432/flashflood

# Alert email channel (optional; alerts are logged to DB and UI without it):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@example.com
